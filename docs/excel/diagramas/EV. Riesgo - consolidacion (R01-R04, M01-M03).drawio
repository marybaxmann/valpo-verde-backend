uot;&gt;Alta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Entre 1× y 1,5× la altura&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Muy baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Media&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Más allá de 1,5× la altura&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Muy baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Muy baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Muy baja&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Baja&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=#D9DFDA;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="640" height="140" as="geometry"/></mxCell><mxCell id="matrices-3" value="&lt;b&gt;M02 · Probabilidad de falla × impacto&lt;/b&gt; (escala intermedia, no se guarda sola)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Prob. de falla \ Prob. de impacto&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Muy baja&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Baja&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Media&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Alta&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Inminente&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Algo probable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Probable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Muy probable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Probable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Algo probable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Probable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Posible&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Algo probable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor