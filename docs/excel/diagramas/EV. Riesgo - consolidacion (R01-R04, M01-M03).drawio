&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Despreciable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Sí, sin necrosis ni raíces cortadas&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Leve&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Sí, con necrosis &lt;i&gt;o&lt;/i&gt; raíces cortadas&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Moderada&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Sí, con necrosis &lt;i&gt;y&lt;/i&gt; raíces cortadas&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Severa&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Cavidad / pudrición basal&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;No presenta&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Despreciable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;p