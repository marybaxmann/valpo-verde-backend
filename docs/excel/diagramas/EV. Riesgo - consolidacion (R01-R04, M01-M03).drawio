aphModel></diagram><diagram id="indicadores" name="2. Indicadores y puntajes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="indicadores-1" value="Indicadores por componente — severidad y puntaje" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#23523F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="indicadores-2" value="&lt;b&gt;R01 · Raíces y cuello&lt;/b&gt; (máx. 9)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Indicador&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Condición&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Severidad&lt;/th&gt;&lt;th style=&quot;border:1px solid #D9DFDA;background:#E3EFE5;padding:4px 6px;&quot;&gt;Pts&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Estabilidad (sin levantamiento de plato radicular)&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Inclinación &amp;lt; 15°&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Despreciable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;15° – 30°&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Leve&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;1&lt;/td&gt;&