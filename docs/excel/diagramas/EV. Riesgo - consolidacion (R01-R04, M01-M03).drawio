9B52B;color:#3d2a00;font-weight:bold;text-align:center;&quot;&gt;Moderado&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#F04A32;color:#ffffff;font-weight:bold;text-align:center;&quot;&gt;Alto&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#F04A32;color:#ffffff;font-weight:bold;text-align:center;&quot;&gt;Alto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Algo probable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#F9B52B;color:#3d2a00;font-weight:bold;text-align:center;&quot;&gt;Moderado&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#F9B52B;color:#3d2a00;font-weight:bold;text-align:center;&quot;&gt;Moderado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;&quot;&gt;Improbable&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;td style=&quot;border:1px solid #D9DFDA;padding:4px 6px;background:#DCE8A9;color:#2b3a10;font-weight:bold;text-align:center;&quot;&gt;Bajo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=#D9DFDA;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="640" height="150" as="geometry"/></mxCell><mxCell id="matrices-5" value="&lt;b&gt;R04 · Consolidación&lt;/b&gt;&lt;br&gt;El nivel de riesgo del árbol es el más desfavorable entre raíces y cuello, tronco y copa y ramas (Bajo &amp;lt; Moderado &amp;lt; Alto &amp;lt; Extremo).&lt;br&gt;Si algún componente es No determinado, el riesgo global queda No determinado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDF5;strokeColor=#C9B98A;fontColor=#4a4a4a;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="640" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>