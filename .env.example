# Servidor
PORT=3000

# Origen permitido para CORS (el frontend, en desarrollo Vite por defecto)
CORS_ORIGIN=http://localhost:5173

# Supabase
# La SUPABASE_SERVICE_ROLE_KEY NUNCA debe usarse en el frontend ni subirse a git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Commit del motor de reglas desplegado (obligatoria): se guarda en cada
# evaluación finalizada (evaluations.motor_commit). Valor de ejemplo; en
# cada despliegue, el hash del commit que se despliega.
MOTOR_COMMIT=0123456789abcdef0123456789abcdef01234567
